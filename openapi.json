  "components" : {
    "schemas" : {
      "NovoCartaoPedido" : {
        "type" : "object",
        "properties" : {
          "apelido" : {
            "type" : "string",
            "maxLength" : 40,
            "minLength" : 0
          },
          "banco" : {
            "type" : "string",
            "enum" : [ "NUBANK", "ITAU", "BRADESCO", "BANCO_DO_BRASIL", "CAIXA", "SANTANDER", "INTER", "C6", "BTG", "MERCADO_PAGO", "OUTRO" ]
          },
          "ultimos4" : {
            "type" : "string",
            "pattern" : "\\d{4}"
          },
          "diaFechamento" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 31,
            "minimum" : 1
          },
          "diaVencimento" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 31,
            "minimum" : 1
          }
        },
        "required" : [ "banco", "diaFechamento", "diaVencimento", "ultimos4" ]
      },
      "CartaoResposta" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "apelido" : {
            "type" : "string"
          },
          "banco" : {
            "type" : "string",
            "enum" : [ "NUBANK", "ITAU", "BRADESCO", "BANCO_DO_BRASIL", "CAIXA", "SANTANDER", "INTER", "C6", "BTG", "MERCADO_PAGO", "OUTRO" ]
          },
          "bancoNome" : {
            "type" : "string"
          },
          "ultimos4" : {
            "type" : "string"
          },
          "diaFechamento" : {
            "type" : "integer",
            "format" : "int32"
          },
          "diaVencimento" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "apelido", "banco", "bancoNome", "diaFechamento", "diaVencimento", "id", "ultimos4" ]
      },
      "SessaoPedido" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "refreshToken" ]
      },
      "Tokens" : {
        "type" : "object",
        "properties" : {
          "tokenAcesso" : {
            "type" : "string"
          },
          "acessoExpiraEm" : {
            "type" : "string",
            "format" : "date-time"
          },
          "refreshToken" : {
            "type" : "string"
          }
        },
        "required" : [ "acessoExpiraEm", "refreshToken", "tokenAcesso" ]
      },
      "RedefinirSenhaPedido" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string",
            "minLength" : 1
          },
          "novaSenha" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 10,
            "pattern" : "^(?=.*\\p{L})(?=.*\\d).*$"
          }
        },
        "required" : [ "novaSenha", "token" ]
      },
      "RecuperarSenhaPedido" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "minLength" : 1
          }
        },
        "required" : [ "email" ]
      },
      "EntrarPedido" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "minLength" : 1
          },
          "senha" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          }
        },
        "required" : [ "email", "senha" ]
      },
      "CadastroPedido" : {
        "type" : "object",
        "properties" : {
          "nome" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "senha" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 10,
            "pattern" : "^(?=.*\\p{L})(?=.*\\d).*$"
          }
        },
        "required" : [ "email", "nome", "senha" ]
      },
      "Conta" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "nome" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "id", "nome" ]
      },
      "BancoResposta" : {
        "type" : "object",
        "properties" : {
          "codigo" : {
            "type" : "string",
            "enum" : [ "NUBANK", "ITAU", "BRADESCO", "BANCO_DO_BRASIL", "CAIXA", "SANTANDER", "INTER", "C6", "BTG", "MERCADO_PAGO", "OUTRO" ]
          },
          "nome" : {
            "type" : "string"
          },
          "modelo" : {
            "type" : "string",
            "enum" : [ "VERIFICADO", "BETA", "SEM_MODELO" ]
          }
        },
        "required" : [ "codigo", "modelo", "nome" ]
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "type" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}
