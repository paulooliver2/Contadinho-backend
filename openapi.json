  "components" : {
    "schemas" : {
      "PessoaPedido" : {
        "type" : "object",
        "properties" : {
          "nome" : {
            "type" : "string",
            "maxLength" : 80,
            "minLength" : 0
          },
          "apelido" : {
            "type" : "string",
            "maxLength" : 40,
            "minLength" : 0
          },
          "whatsapp" : {
            "type" : "string",
            "maxLength" : 30,
            "minLength" : 0
          }
        },
        "required" : [ "nome" ]
      },
      "PessoaResposta" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "nome" : {
            "type" : "string"
          },
          "apelido" : {
            "type" : "string"
          },
          "whatsapp" : {
            "type" : "string"
          },
          "arquivada" : {
            "type" : "boolean"
          }
        },
        "required" : [ "arquivada", "id", "nome" ]
      },
      "CompraPedido" : {
        "type" : "object",
        "properties" : {
          "data" : {
            "type" : "string",
            "format" : "date"
          },
          "descricao" : {
            "type" : "string",
            "maxLength" : 255,
            "minLength" : 0
          },
          "valor" : {
            "type" : "number"
          },
          "parcelaAtual" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 99,
            "minimum" : 1
          },
          "parcelaTotal" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 99,
            "minimum" : 1
          }
        },
        "required" : [ "data", "descricao", "valor" ]
      },
      "LancamentoResposta" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "data" : {
            "type" : "string",
            "format" : "date"
          },
          "descricao" : {
            "type" : "string"
          },
          "valor" : {
            "type" : "number"
          },
          "parcelaAtual" : {
            "type" : "integer",
            "format" : "int32"
          },
          "parcelaTotal" : {
            "type" : "integer",
            "format" : "int32"
          },
          "finalCartao" : {
            "type" : "string"
          },
          "origem" : {
            "type" : "string",
            "enum" : [ "ARQUIVO", "MANUAL" ]
          },
          "pessoaId" : {
            "type" : "string",
            "format" : "uuid"
          }
        },
        "required" : [ "data", "descricao", "id", "origem", "valor" ]
      },
      "ResponsavelPedido" : {
        "type" : "object",
        "properties" : {
          "pessoaId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "proximas" : {
            "type" : "boolean"
          }
        }
      },
      "AtribuicaoResposta" : {
        "type" : "object",
        "properties" : {
          "lancamento" : {
            "$ref" : "#/components/schemas/LancamentoResposta"
          },
          "proximas" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "lancamento", "proximas" ]
      },
      "PagamentoPedido" : {
        "type" : "object",
        "properties" : {
          "valor" : {
            "type" : "number",
            "minimum" : 0.01
          },
          "recebidoEm" : {
            "type" : "string",
            "format" : "date"
